# ── Server ───────────────────────────────────────────────────────────────────
PORT=3001

# URL of the React frontend (used for CORS and Stripe redirect URLs)
ORIGIN=http://localhost:5173

# In production set to "production" to serve the built client
NODE_ENV=development

# ── Stripe ───────────────────────────────────────────────────────────────────
# Get your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Email Notifications (Nodemailer) ─────────────────────────────────────────
# The email address that receives new order notifications
NOTIFY_EMAIL_TO=owner@donutbuff.com

# The "From" address shown in notification emails
NOTIFY_EMAIL_FROM=orders@donutbuff.com

# SMTP server settings — works with Gmail, Mailgun, SendGrid, etc.
# Gmail example: SMTP_HOST=smtp.gmail.com  SMTP_PORT=587
#   Use an App Password (not your regular password):
#   https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
